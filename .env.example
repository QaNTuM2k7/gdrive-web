# ─── Required ───────────────────────────────────────────────────────────────

# Postgres connection string. Local dev uses docker-compose (port 5433).
DATABASE_URL=postgres://gdrive:gdrive@127.0.0.1:5433/gdrive

# Random string of at least 32 characters used to sign admin sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of the site, no trailing slash. Used for canonicals, sitemap, structured data,
# and CORS/CSRF for the admin. Build-time value (compiled into the browser bundle).
# On Vercel it may be left empty: the project's production domain is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Cloudflare Turnstile spam protection, off for now (the honeypot and rate limit still run).
# Set to "true" to turn it on; build-time value. The keys below are Cloudflare's published test
# keys (always pass); create real keys at dash.cloudflare.com for each domain.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Production switches ────────────────────────────────────────────────────

# "true" only on the live domain: lets search engines index the site (build-time value).
NEXT_PUBLIC_ALLOW_INDEXING=false

# "true" once the client's legal adviser approves the privacy policy and terms (build-time value).
NEXT_PUBLIC_LEGAL_APPROVED=false

# Temporarily "true" to allow creating the first admin from /admin in production.
# Prefer `npm run seed:admin` instead and leave this false.
ALLOW_FIRST_USER_SIGNUP=false

# ─── Lead notifications (optional) ─────────────────────────────────────────

# Inbox that receives an email for every new lead. Leave empty to skip notifications.
LEADS_NOTIFY_TO=

# SMTP settings. Without SMTP_HOST, emails are written to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=G DRIVE Website

# ─── Media storage (optional) ──────────────────────────────────────────────

# S3-compatible bucket for uploaded media (AWS S3, Cloudflare R2, MinIO...).
# Without S3_BUCKET, uploads are stored on disk in ./media (mount a persistent volume).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, if images are served from it (allowed in the CSP).
S3_PUBLIC_URL=

# Vercel Blob storage (used on Vercel when S3_BUCKET is not set). Added automatically when you connect
# a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# ─── Admin seed (used by `npm run seed:admin`) ─────────────────────────────

ADMIN_EMAIL=
ADMIN_PASSWORD=
