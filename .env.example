# Postgres connection string. Local dev uses docker-compose (port 5433).
DATABASE_URL=postgres://gdrive:gdrive@127.0.0.1:5433/gdrive

# Long random string used to sign Payload auth tokens.
PAYLOAD_SECRET=change-me

# Public URL of the site, used for canonicals, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Set to "true" only on production so search engines may index the site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Cloudflare Turnstile. These are Cloudflare's published test keys (always pass); use real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Inbox that receives a notification for every new lead. Leave empty to skip notifications.
LEADS_NOTIFY_TO=
